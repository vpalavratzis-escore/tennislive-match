# Canonical VoxCourt API. The legacy api.escoreboards.eu host remains unchanged.
server {
    listen 80;
    listen [::]:80;
    server_name api.voxcourt.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.voxcourt.com;

    # api.voxcourt.com is Cloudflare-proxied. This origin certificate is replaced
    # with a dedicated Let's Encrypt certificate when DNS validation permits it.
    ssl_certificate /etc/letsencrypt/live/voxcourt.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voxcourt.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 16m;

    # Club registry, member, admin, setup and hardware families (port 8085).
    location ~ ^/api/(public|member|admin|hardware|setup|media)(/|$) {
        proxy_pass http://127.0.0.1:8085;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Score, state, match, replay, event and controller families (port 8010).
    location /api/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_buffering off;
    }

    location ^~ /media/ {
        alias /var/www/tennislive/media/;
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "https://voxcourt.com" always;
        try_files $uri =404;
    }

    location ^~ /hls/ {
        alias /srv/hls/;
        types { application/vnd.apple.mpegurl m3u8; video/mp2t ts; image/jpeg jpg jpeg; }
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Access-Control-Allow-Origin "https://voxcourt.com" always;
        expires -1;
        try_files $uri =404;
    }

    location ^~ /webrtc/ {
        proxy_pass http://127.0.0.1:8889/;
        proxy_redirect / /webrtc/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location / { return 404; }
}
